# ===== local runtime state =====
.cron_state.json
.scan.lock
.watch.lock

# ===== uptime monitoring =====
uptime_log.csv
uptime_log.csv.1
SITE_DOWN_ALERT.txt
daily_scan.log

# ===== historical scan snapshots =====
# Each run writes ai_earnings_57day_<ts>.{html,csv}. These accumulate ~2 per
# day and are purely archival - the live page is ai_earnings_today.html.
# Before this was ignored the repo carried 1000+ untracked files, which made
# git status unusable and made `git stash -u` catastrophic.
ai_earnings_57day_*.html
ai_earnings_57day_*.csv

# ===== scratch / one-off scripts =====
# Ad-hoc _fix_*.py / _check_*.py / _verify_*.py helpers written during
# debugging. Not part of the site.
_*.py
_*.js
_*.html
_*.txt
_*.json

# ===== python =====
__pycache__/
*.pyc

# ===== backups =====
*.bak
*.bak2
*.guardtest

# ===== indexing runtime state =====
# daily_index.ps1 rewrites these on every run. They are local state, not source.
#
# HISTORY: commit 68ba3c7 concatenated two patterns into one bogus line
# ("*.guardtest.indexnow_state.json"), so this section silently ignored
# nothing and git status kept showing these files as untracked. Verify any new
# pattern with `git check-ignore -v <file>` before trusting it.
.indexnow_state.json
indexing.log
indexnow.log
.index.lock

# ===== visitor counter runtime state =====
# Written by the live Flask app on every page view, flushed every 20s.
# Runtime state, never source. The all-time total that must survive a redeploy
# lives in the git-tracked visitor_baseline.json instead.
visitor_counts.json
visitor_counts.json.tmp

# ===== ad-hoc repair helpers (no leading underscore) =====
# One-off scripts that rewrote a single page and were never wired into a task.
fix_dram_link.py
fix_ticker_links.py
verify_fix.py

# ===== checkout probe cache =====
# verify_payment_live.py caches the /create-checkout verdict for an hour so it
# does not mint a fresh Stripe checkout session on every scan. Runtime state,
# never source. Verified with `git check-ignore -v` after adding, per the note
# in the indexing section below - a pattern that silently matches nothing is
# worse than no pattern at all.
.checkout_probe_cache.json

# ===== scan guard marker =====
# Written by daily_scan.ps1 when it SKIPS the hard reset because tracked files
# have uncommitted changes. Runtime state for the ops dashboard, never source.
# It must stay ignored or it would itself count as a tracked change.
scan_guard_skip.txt
# Written by daily_scan.ps1 when verify_payment_live.py reports the LIVE site
# does not match the source (stale Railway build). Same reasoning.
live_stale_deploy.txt

# ===== build staging / logs =====
# _build_clean_html.py writes test_scanner.html here, then copies it to the
# Desktop. The deployed page is ai_earnings_today.html; this is an intermediate.
test_scanner.html
# Written by content_pipeline\run_daily.bat (Blogger lane). Log only.
traffic_publish.log

# ===== Blogger lane backups (Blogger lane) =====
# content_pipeline\_bk_20261020\ holds pre-scrub copies of scanner_web.py and
# blog_to_railway.py. scanner_web.py is the live Flask app name, so any bare
# `import scanner_web` resolving into this directory would load a stale copy
# containing retired X routes — the exact failure class of the stale-import
# bug found in verify_routes.py. Untracked and unreferenced, but kept ignored
# so it can never be committed and become a real import target.
content_pipeline/_bk_*/
# Blogger lane verifier output written by run_daily.bat. Log only.
verify_blogger_lane.out
scan.env
scan_queue.json
scan_poller.lock
scan_poller.log


# ===== Manual .bak_* snapshots =====
# Lane owners take timestamped copies of scanner_web.py / ai_earnings_scanner.py
# before editing. Ten of these were sitting untracked and UNIGNORED, so any
# 'git add .' would have committed the pre-paywall copy of scanner_web.py -
# the version whose PUBLIC HTML leaked the paid target/stop numbers. Ignore
# them so a stray add can never resurrect that file into the repo.
*.bak_*

# Customer email addresses. The daily alert list is PII and must
# never reach the repo - same rule as scan.env and stripe.env.
email_list.json

# SMTP / provider credentials for the daily alert. Never committed.
alert.env
# holds subscriber email addresses - never commit
alert_sent_log.json
# ad-hoc probe, not part of the pipeline
test_send_to_tyler.py
