#!/bin/sh
# Pre-commit gate: never let a broken ai_earnings_today.html reach git.
#
# Every regression in this project had the same shape - the Python source was
# correct but the generated HTML was stale or broken, and it got committed and
# deployed anyway. This blocks that at the last possible moment.
#
# Set SKIP_GUARD=1 to bypass in an emergency:
#   SKIP_GUARD=1 git commit ...
#
# NOTE: .git/hooks/ is not version-controlled. If the repo is recloned or the
# hooks directory is reset, reinstall with:
#   powershell -ExecutionPolicy Bypass -File install_hooks.ps1

STAGED=$(git diff --cached --name-only)

# ---- refresh the durable signup counter BEFORE the commit ----------------
# The free-signup counter lives on Railway's container disk and every
# redeploy destroys it. The committed signup_baseline.json is what seeds the
# next boot, so a commit that does not carry a fresh count ships a stale one -
# and every push is a deploy.
#
# It has to happen HERE, before the commit exists. A commit made inside a
# pre-push hook is NOT pushed: git resolves the ref list before the hook runs,
# so the new commit stays local and is never deployed. Verified, not assumed.
#
# NEVER blocks the commit. A counter that cannot be read must never stop a
# deploy of real fixes - a missing count is an analytics problem, a blocked
# commit is an outage.
ROOT_SYNC=$(git rev-parse --show-toplevel)
if [ -f "$ROOT_SYNC/sync_signup_counter.py" ]; then
  PYS=""
  for c in python python3 py; do
    if command -v "$c" >/dev/null 2>&1; then PYS="$c"; break; fi
  done
  if [ -n "$PYS" ]; then
    "$PYS" "$ROOT_SYNC/sync_signup_counter.py" >/dev/null 2>&1
    if git -C "$ROOT_SYNC" diff --quiet -- signup_baseline.json; then
      :
    else
      git -C "$ROOT_SYNC" add signup_baseline.json
      echo "pre-commit: refreshed signup_baseline.json from the live counter"
    fi
  fi
fi

# ---- gate 1: retired routes must not come back -----------------------------
case "$STAGED" in
  *scanner_web.py*|*email_unsubscribe.py*|*send_daily_alert.py*|*pull_email_list.py*)
    if [ "$SKIP_GUARD" != "1" ]; then
      ROOT0=$(git rev-parse --show-toplevel)
      cd "$ROOT0" || exit 1
      PY0=""
      for c in python python3 py; do
        if command -v "$c" >/dev/null 2>&1; then PY0="$c"; break; fi
      done
      if [ -n "$PY0" ]; then
        echo "pre-commit: running route guard..."
        if ! "$PY0" verify_routes.py; then
          echo ""
          echo "=============================================================="
          echo " COMMIT BLOCKED - a retired route or X code path returned."
          echo ""
          echo " /cron-twitter, /cron and /cron-afternoon were deliberately"
          echo " removed. Re-adding any of them restores either a live X"
          echo " posting endpoint or a dead route that only pretended to scan."
          echo "=============================================================="
          exit 1
        fi
        echo "pre-commit: running auth guard..."
        if ! "$PY0" verify_auth.py; then
          echo ""
          echo "=============================================================="
          echo " COMMIT BLOCKED - an authentication invariant is broken."
          echo ""
          echo " /login must never grant Pro access on the strength of an"
          echo " email alone, and /webhook must fail closed when"
          echo " STRIPE_WEBHOOK_SECRET is unset. Re-introducing either one"
          echo " lets anyone who knows a subscriber's email read Pro for"
          echo " free, or forge Stripe events to grant access to anyone."
          echo "=============================================================="
          exit 1
        fi
        # The email lane's own guards. scanner_web.py holds the export route
        # and the one-click unsubscribe, and the token is one secret doing
        # two jobs, so a change to any of these files has to pass the
        # transport guard AND the mutation proof that proves the guard bites.
        echo "pre-commit: running email transport guard..."
        if ! "$PY0" verify_email_list.py; then
          echo ""
          echo "=============================================================="
          echo " COMMIT BLOCKED - the email list transport is broken."
          echo ""
          echo " The export route, the one-click unsubscribe, or the PII"
          echo " handling has a regression. Addresses could leak, the export"
          echo " could break while every health check still looks healthy,"
          echo " or a token pasted with a trailing newline could compare"
          echo " unequal and strand the free list."
          echo "=============================================================="
          exit 1
        fi
        echo "pre-commit: running token mutation proof..."
        if ! "$PY0" prove_email_token_bites.py; then
          echo ""
          echo "=============================================================="
          echo " COMMIT BLOCKED - the token-normalization guard does not bite."
          echo ""
          echo " A mutant survived, so the checks covering a pasted token are"
          echo " no longer testing anything they claim to test."
          echo "=============================================================="
          exit 1
        fi
      fi
    fi
    ;;
esac

case "$STAGED" in
  *ai_earnings_today.html*) ;;
  *) exit 0 ;;   # nothing scanner-related staged, nothing to check
esac

if [ "$SKIP_GUARD" = "1" ]; then
  echo "pre-commit: SKIP_GUARD=1 set, bypassing HTML regression check"
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

PY=""
for c in python python3 py; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done

if [ -z "$PY" ]; then
  echo "pre-commit: no python found, skipping check"
  exit 0
fi

echo "pre-commit: running HTML regression guard..."
if "$PY" verify_output.py; then
  echo "pre-commit: OK"
  exit 0
else
  echo ""
  echo "=============================================================="
  echo " COMMIT BLOCKED - ai_earnings_today.html has a regression."
  echo ""
  echo " The page you are about to publish is broken. Fix the scanner,"
  echo " regenerate the HTML, and re-run:"
  echo "     python ai_earnings_scanner.py --no-finviz"
  echo "=============================================================="
  echo ""
  echo " To bypass deliberately (not recommended):"
  echo "     SKIP_GUARD=1 git commit ..."
  exit 1
fi